rules_version = '2';

// =====================================================================
// قواعد أمان Firestore — نظام فيا هورايزن
// انسخي هذا الملف كاملاً في: console.firebase.google.com
//   ← Firestore Database ← Rules ← الصق ← Publish
//
// القاعدة باختصار: لا أحد يقرأ أو يكتب أي شيء إلا بعد تسجيل الدخول
// بحساب موظف أنشأتِه أنت في Firebase Authentication.
// =====================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // الصفقات والعقود
    match /deals/{dealId} {
      allow read, write: if signedIn();
    }

    // الفواتير
    match /invoices/{invoiceId} {
      allow read, write: if signedIn();
    }

    // طلبات عروض الأسعار الواردة من فورم الموقع (form.html)
    // العميل غير مسجّل دخول، لذا يُسمح بالإنشاء فقط ضمن شروط صارمة،
    // ولا يُسمح بالقراءة أو التعديل أو الحذف إلا لموظفي الشركة.
    match /leads/{leadId} {
      allow create: if request.resource.data.keys().hasOnly(
                        ['id','ref','orgName','contactName','jobTitle','email','phone',
                         'city','carsCount','expectedStart','at','source','converted','dealId'])
                    && request.resource.data.converted == false
                    && request.resource.data.source == 'form'
                    && request.resource.data.orgName is string
                    && request.resource.data.orgName.size() > 0
                    && request.resource.data.orgName.size() <= 120
                    && request.resource.data.contactName is string
                    && request.resource.data.contactName.size() <= 80
                    && request.resource.data.email is string
                    && request.resource.data.email.size() <= 120
                    && request.resource.data.phone is string
                    && request.resource.data.phone.size() <= 20
                    && request.resource.data.carsCount is number
                    && request.resource.data.carsCount > 0
                    && request.resource.data.carsCount <= 200;
      allow read, update, delete: if signedIn();
    }

    // سجل السائقين
    match /drivers/{driverId} {
      allow read, write: if signedIn();
    }

    // سجل الأحداث — يُكتب ولا يُعدّل ولا يُحذف
    match /audit/{logId} {
      allow read, create: if signedIn();
      allow update, delete: if false;
    }

    // الإعدادات
    match /settings/{docId} {
      allow read, write: if signedIn();
    }

    // أي مسار آخر مرفوض
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
